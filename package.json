{
  "name": "wellbeing-transition-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/run-anchor-tests.ts",
    "validate:futures": "tsx scripts/validate-futures.ts",
    "validate:korinek": "tsx scripts/validate-korinek.ts",
    "hindcast:fetch": "tsx scripts/hindcast/fetch-actuals.ts",
    "hindcast": "tsx scripts/hindcast/run-hindcast.ts",
    "futures:aggregate": "tsx scripts/futures-aggregate.ts",
    "check": "npm run typecheck && npm run test && npm run validate && npm run validate:futures && npm run validate:korinek && npm run build",
    "deploy": "bash scripts/deploy.sh",
    "deploy:promote": "bash scripts/deploy.sh --promote"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "d3": "^7.9.0",
    "firebase": "^11.10.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.562.0",
    "mathjs": "^15.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "topojson-client": "^3.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
