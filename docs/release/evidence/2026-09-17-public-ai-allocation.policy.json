  "model": {
    "schemaVersion": 1,
    "id": "reported-allocation-apple-fy2025",
    "name": "Apple FY2025: cash-flow allocation",
    "description": "Raw source cash flow = operating cash flow minus the reported cash investment item. Allocation ceiling = max(0, raw source cash flow). Payments for acquisition of property, plant and equipment. Cash PP&E purchases; excludes separately reported financing and other investing activities.",
    "scope": "A proposed allocation of one company’s reported annual cash flow, before dividends and buybacks. It may redirect existing uses. This is not idle cash or measured AI-generated cash. One fiscal year; monthly payment = annual resident allocation divided by 12 and resident count. Not a forecast or observed monthly cash flow. Training cost, capacity, eligibility, placement rate and openings are scenario assumptions. Gross placements do not estimate net jobs or causal wellbeing effects. Unspent training money stays unspent.",
    "sources": [
      {
        "label": "Apple FY2025: reported observation",
        "url": "https://www.sec.gov/Archives/edgar/data/320193/000032019325000079/aapl-20250927.htm",
        "note": "2024-09-29–2025-09-27; source USD millions converted once to nominal dollars; report 2025-10-31, retrieved 2026-09-15. Payments for acquisition of property, plant and equipment. Cash PP&E purchases; excludes separately reported financing and other investing activities."
      },
      {
        "label": "World Bank WDI, Population, total, 2024 residents, United States",
        "url": "https://api.worldbank.org/v2/country/all/indicator/SP.POP.TOTL?format=json&per_page=20000&date=2018:2024",
        "note": "countries-wb-2026-09; retrieved 2026-09-14; Raw SP.POP.TOTL people; millions = raw / 1,000,000. Rounded legacy engine millions are not used."
      },
      {
        "label": "Editable policy scenario assumption",
        "kind": "assumed"
      }
    ],
    "time": {
      "start": 2025,
      "end": 2025,
      "step": "year"
    },
    "parameters": [
      {
        "id": "reported_operating_cash_flow",
        "value": 111482000000,
        "unit": "usd",
        "source": {
          "label": "Apple FY2025: reported observation",
          "url": "https://www.sec.gov/Archives/edgar/data/320193/000032019325000079/aapl-20250927.htm",
          "note": "2024-09-29–2025-09-27; source USD millions converted once to nominal dollars; report 2025-10-31, retrieved 2026-09-15. Payments for acquisition of property, plant and equipment. Cash PP&E purchases; excludes separately reported financing and other investing activities."
        }
      },
      {
        "id": "reported_cash_investment",
        "value": 12715000000,
        "unit": "usd",
        "source": {
          "label": "Payments for acquisition of property, plant and equipment",
          "url": "https://www.sec.gov/Archives/edgar/data/320193/000032019325000079/aapl-20250927.htm",
          "note": "2024-09-29–2025-09-27; source USD millions converted once to nominal dollars; report 2025-10-31, retrieved 2026-09-15. Payments for acquisition of property, plant and equipment. Cash PP&E purchases; excludes separately reported financing and other investing activities."
        }
      },
      {
        "id": "recipient_population",
        "value": 340003797,
        "unit": "people",
        "source": {
          "label": "United States, sourced 2024 residents",
          "url": "https://api.worldbank.org/v2/country/all/indicator/SP.POP.TOTL?format=json&per_page=20000&date=2018:2024",
          "note": "Raw SP.POP.TOTL people; millions = raw / 1,000,000. Rounded legacy engine millions are not used."
        }
      },
      {
        "id": "policy_share",
        "value": 0.1,
        "unit": "share",
        "source": {
          "label": "Editable policy scenario assumption",
          "kind": "assumed"
        }
      },
      {
        "id": "training_share",
        "value": 0,
        "unit": "share",
        "source": {
          "label": "Editable policy scenario assumption",
          "kind": "assumed"
        }
      },
      {
        "id": "cost_per_completion",
        "value": 5000,
        "unit": "usd/person",
        "source": {
          "label": "Editable policy scenario assumption",
          "kind": "assumed"
        }
      },
      {
        "id": "instructor_capacity",
        "value": 100000,
        "unit": "people",
        "source": {
          "label": "Editable policy scenario assumption",
          "kind": "assumed"
        }
      },
      {
        "id": "eligible_trainees",
        "value": 1000000,
        "unit": "people",
        "source": {
          "label": "Editable policy scenario assumption",
          "kind": "assumed"
        }
      },
      {
        "id": "placement_rate",
        "value": 0.5,
        "unit": "share",
        "source": {
          "label": "Editable policy scenario assumption",
          "kind": "assumed"
        }
      },
      {
        "id": "suitable_openings",
        "value": 50000,
        "unit": "people",
        "source": {
          "label": "Editable policy scenario assumption",
          "kind": "assumed"
        }
      }
    ],
    "variables": [
      {
        "id": "source_cash_flow",
        "equation": "reported_operating_cash_flow - reported_cash_investment",
        "unit": "usd",
        "description": "Raw annual difference; negative values remain visible.",
        "hook": false
      },
      {
        "id": "allocatable_base",
        "equation": "max(0, source_cash_flow)",
        "unit": "usd",
        "description": "Explicit nonnegative allocation ceiling, before existing shareholder distributions.",
        "hook": false
      },
      {
        "id": "policy_budget",
        "equation": "allocatable_base * policy_share",
        "unit": "usd",
        "hook": false
      },
      {
        "id": "training_budget",
        "equation": "policy_budget * training_share",
        "unit": "usd",
        "hook": false
      },
      {
        "id": "dividend_spend",
        "equation": "policy_budget - training_budget",
        "unit": "usd",
        "description": "Proposed resident payments, distinct from reported shareholder dividends.",
        "hook": false
      },
      {
        "id": "completions",
        "equation": "min(training_budget / cost_per_completion, instructor_capacity, eligible_trainees, recipient_population)",
        "unit": "people",
        "description": "Continuous expected completion count; budget, capacity, eligibility and residents all constrain it.",
        "hook": false
      },
      {
        "id": "actual_training_spend",
        "equation": "completions * cost_per_completion",
        "unit": "usd",
        "hook": false
      },
      {
        "id": "unspent_training",
        "equation": "training_budget - actual_training_spend",
        "unit": "usd",
        "description": "Unused training money; never automatically diverted to residents.",
        "hook": false
      },
      {
        "id": "placements",
        "equation": "min(completions * placement_rate, suitable_openings)",
        "unit": "people",
        "description": "Gross expected placements, not net jobs or causal impact.",
        "hook": false
      },
      {
        "id": "monthly_dividend_per_person",
        "equation": "dividend_spend / 12 / recipient_population",
        "unit": "usd/person/month",
        "hook": false
      }
    ],
    "outputs": [
      "source_cash_flow",
      "allocatable_base",
      "policy_budget",
      "training_budget",
      "dividend_spend",
      "completions",
      "actual_training_spend",
      "unspent_training",
      "placements",
      "monthly_dividend_per_person"
    ],
    "invariants": [
      {
        "id": "pinned-observations",
        "expr": "reported_operating_cash_flow == 111482000000 and reported_cash_investment == 12715000000 and recipient_population == 340003797",
        "description": "Reported observations stay pinned; changing observations requires an explicit model fork and revised provenance."
      },
      {
        "id": "valid-shares",
        "expr": "policy_share >= 0 and policy_share <= 1 and training_share >= 0 and training_share <= 1 and placement_rate >= 0 and placement_rate <= 1"
      },
      {
        "id": "valid-inputs",
        "expr": "cost_per_completion > 0 and instructor_capacity >= 0 and eligible_trainees >= 0 and suitable_openings >= 0 and recipient_population > 0 and reported_cash_investment >= 0"
      },
      {
        "id": "within-source-ceiling",
        "expr": "policy_budget >= 0 and policy_budget <= allocatable_base"
      },
      {
        "id": "conserve-policy-budget",
        "expr": "abs(policy_budget - dividend_spend - training_budget) <= max(0.000001, abs(policy_budget) * 1e-12)"
      },
      {
        "id": "conserve-training-budget",
        "expr": "abs(training_budget - actual_training_spend - unspent_training) <= max(0.000001, abs(training_budget) * 1e-12)"
      },
      {
        "id": "nonnegative-spending",
        "expr": "dividend_spend >= 0 and training_budget >= 0 and actual_training_spend >= 0 and unspent_training >= -max(0.000001, training_budget * 1e-12)"
      },
      {
        "id": "training-spend-limit",
        "expr": "actual_training_spend <= training_budget + max(0.000001, training_budget * 1e-12)"
      },
      {
        "id": "completion-limits",
        "expr": "completions >= 0 and completions <= instructor_capacity and completions <= eligible_trainees and completions <= recipient_population"
      },
      {
        "id": "placement-limits",
        "expr": "placements >= 0 and placements <= completions and placements <= suitable_openings and placements <= recipient_population"
      },
      {
        "id": "resident-accounting",
        "expr": "abs(monthly_dividend_per_person * 12 * recipient_population - dividend_spend) <= max(0.000001, abs(dividend_spend) * 1e-12)"
      }
    ]
  },
