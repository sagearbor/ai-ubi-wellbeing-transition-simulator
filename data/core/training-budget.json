{
  "schemaVersion": 1,
  "id": "training-budget",
  "name": "Training funding meets a jobs constraint",
  "description": "The v3 worked example. One year at a time: a training budget buys completions, capped by instructor capacity and eligible people; completions place at a rate, capped by suitable openings. All numbers are illustrative assumptions, not estimates.",
  "scope": "Arithmetic and interface fixture. Tracks gross placements through one channel. Says nothing about net employment, displacement of other workers, earnings, or the wider value of education.",
  "time": {
    "start": 2026,
    "end": 2029,
    "step": "year"
  },
  "parameters": [
    {
      "id": "cost_per_completion",
      "value": 5000,
      "unit": "usd",
      "source": {
        "label": "illustrative",
        "kind": "guess"
      }
    },
    {
      "id": "instructor_capacity",
      "value": 3000,
      "unit": "people",
      "range": {
        "dist": "uniform",
        "p5": 2000,
        "p95": 4000
      },
      "source": {
        "label": "illustrative",
        "kind": "guess"
      }
    },
    {
      "id": "eligible_people",
      "value": 10000,
      "unit": "people",
      "source": {
        "label": "illustrative",
        "kind": "guess"
      }
    },
    {
      "id": "placement_rate",
      "value": 0.5,
      "unit": "share",
      "range": {
        "dist": "uniform",
        "p5": 0.3,
        "p95": 0.7
      },
      "bounds": [
        0,
        1
      ],
      "source": {
        "label": "illustrative",
        "kind": "guess"
      }
    },
    {
      "id": "suitable_openings",
      "value": 1000,
      "unit": "people",
      "range": {
        "dist": "uniform",
        "p5": 600,
        "p95": 1600
      },
      "source": {
        "label": "illustrative",
        "kind": "guess"
      }
    }
  ],
  "inputs": [
    {
      "id": "training_budget",
      "unit": "usd",
      "interp": "step",
      "curve": {
        "2026": 6000000,
        "2027": 10000000,
        "2028": 11000000,
        "2029": 20000000
      },
      "source": {
        "label": "the authorised budget path in the v3 table",
        "kind": "assumed"
      }
    }
  ],
  "variables": [
    {
      "id": "funded_completions",
      "unit": "people",
      "equation": "training_budget / cost_per_completion",
      "description": "Completions the budget pays for (budget / cost). Not a hook: raising it without money would overspend the budget; change the budget input or the cost instead.",
      "hook": false
    },
    {
      "id": "completions",
      "unit": "people",
      "equation": "min(funded_completions, instructor_capacity, eligible_people)",
      "hook": false,
      "description": "People who finish training this year (limited; effects cannot attach after the limit)"
    },
    {
      "id": "actual_training_spend",
      "unit": "usd",
      "equation": "completions * cost_per_completion",
      "hook": false
    },
    {
      "id": "unspent_budget",
      "unit": "usd",
      "equation": "training_budget - actual_training_spend",
      "hook": false
    },
    {
      "id": "potential_placements",
      "unit": "people",
      "equation": "completions * placement_rate",
      "description": "Placements the completions would produce with unlimited openings. Effects on placement rates attach here, before the openings limit."
    },
    {
      "id": "placements",
      "unit": "people",
      "equation": "min(potential_placements, suitable_openings)",
      "hook": false,
      "description": "Placements through this channel (limited by openings)"
    }
  ],
  "outputs": [
    "completions",
    "actual_training_spend",
    "unspent_budget",
    "placements"
  ],
  "tests": [
    {
      "name": "$11M: openings bind, 1000 placements",
      "at": 2028,
      "expr": "placements",
      "expected": 1000,
      "tol": 0
    },
    {
      "name": "$20M: capacity binds, $5M unspent",
      "at": 2029,
      "expr": "unspent_budget",
      "expected": 5000000,
      "tol": 0
    }
  ],
  "invariants": [
    {
      "id": "within-instructor-capacity",
      "expr": "completions <= instructor_capacity",
      "description": "Completions never exceed instructor capacity"
    },
    {
      "id": "within-eligible",
      "expr": "completions <= eligible_people",
      "description": "Completions never exceed eligible people"
    },
    {
      "id": "within-openings",
      "expr": "placements <= suitable_openings",
      "description": "Placements never exceed suitable openings"
    },
    {
      "id": "budget-not-overspent",
      "expr": "unspent_budget >= -1e-6",
      "description": "Spending never exceeds the budget (accounting)"
    }
  ]
}
